# Copy to .env and edit before first run:
#   cp .env.example .env
#
# REQUIRED for any shared / internet-facing deploy: change HUB_SECRET to a long random string.
# Compose refuses to start if HUB_SECRET is unset. The example default below is for local dev only.
DATABASE_URL=postgres://notehub:notehub@127.0.0.1:5432/notehub
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=hub-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
HUB_SECRET=dev-hub-secret-change-me
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
VAULT_BUCKET=obsidian-src

# optional — Ask works extractively without these
OPENAI_BASE_URL=
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
# optional embeddings (dim 1536). Unset BASE_URL+API_KEY → local hashed n-gram projector
EMBEDDING_MODEL=text-embedding-3-small
# embed_provider: api | local (settings UI can override). local uses @xenova/transformers ONNX.
EMBED_PROVIDER=api
# directory for downloaded local embed models (shared by api + worker)
# Compose mounts ./DATA/models at /data/models
EMBED_MODEL_DIR=
# 语义检索预算（毫秒）。搜索时关键词与向量并行跑，向量超过此预算就丢弃。
# 本地 ONNX 模型首次加载需数秒 → 400ms 会让向量结果恒为空；默认 3000。
# 设为 0 可禁用语义检索（只保留关键词）。
SEARCH_SIMILAR_BUDGET_MS=3000

# optional OCR binaries. Unset -> images use tesseract.js from node_modules.
# TESSERACT_BIN=
# PDFTOTEXT_BIN=
# ANTIWORD_BIN=

# optional — Notion public OAuth. Integration Token still works as fallback.
# Register a public integration at https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:3000/v1/connections/oauth/notion/callback

# optional — Feishu user OAuth (QR scan). App ID/Secret may also live on the connection.
# Add this redirect URI in 飞书开放平台 → 开发配置 → 安全设置 → 重定向 URL
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:3000/v1/connections/oauth/feishu/callback

# ── 账号与安全防护 ────────────────────────────────────────────────
# 是否开放自助注册。false = 关闭注册，仅已有账号可登录（公网部署建议 false）
ALLOW_REGISTRATION=true
# 登录防暴力破解：窗口期内允许的失败次数，超过即临时锁定
LOGIN_MAX_ATTEMPTS=5
# 失败计数窗口（分钟）
LOGIN_WINDOW_MINUTES=15
# 触发后锁定时长（分钟）
LOGIN_LOCK_MINUTES=15
# 同一 IP 在窗口期内最大注册数（0 = 不限制）
REGISTER_MAX_PER_IP=5
# IP 注册计数窗口（分钟）
REGISTER_WINDOW_MINUTES=60
# 是否信任反向代理的 X-Forwarded-For（lucky/nginx/Cloudflare 后部署请 true）
TRUST_PROXY=true

# ── 目录与端口（可选，留空用默认 ./DATA 与 9000/9001/3000/3001）──
# 数据根目录（Postgres/Redis/MinIO/模型都放这里）
# DATA_DIR=/all-note-rag/data
# MinIO 端口（宿主被占用时改这里）
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
