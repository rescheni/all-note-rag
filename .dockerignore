# build context — keep images small and avoid leaking host state
.git
.gitignore
.cursor
.grok
.impeccable
**/.DS_Store

# deps & build artifacts
**/node_modules
**/.next
**/dist
**/.turbo
**/coverage
**/*.log

# secrets (compose injects env; never bake .env)
.env
.env.*
!.env.example

# local / persistent data (compose bind-mounts ./DATA)
/data/
data/
DATA/
cloud-agent-transcripts
**/.cache

# tests are not needed in runtime images
**/tests
**/*.test.ts
**/*.spec.ts
**/vitest.config.ts

# host-only docs
docs
DESIGN.md
PRODUCT.md
LICENSE
